## 3. Database Schema

All tables live in the `public` schema in Supabase Postgres. Hasura tracks all tables.

### 3.1 Core Tables

```sql
-- Family account: top-level owner of all data
CREATE TABLE family_accounts (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  created_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

-- Users: both parents and guests
CREATE TABLE users (
  id UUID PRIMARY KEY REFERENCES auth.users(id) ON DELETE CASCADE,
  family_account_id UUID REFERENCES family_accounts(id),
  name TEXT NOT NULL,
  avatar_url TEXT,
  role TEXT NOT NULL CHECK (role IN ('parent', 'guest')),
  created_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

-- Children profiles
CREATE TABLE children (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  family_account_id UUID NOT NULL REFERENCES family_accounts(id) ON DELETE CASCADE,
  name TEXT NOT NULL,
  photo_url TEXT,
  date_of_birth DATE,
  gender TEXT CHECK (gender IN ('male', 'female', 'other', 'prefer_not_to_say')),
  created_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

-- Tales
CREATE TABLE tales (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  family_account_id UUID NOT NULL REFERENCES family_accounts(id) ON DELETE CASCADE,
  author_id UUID NOT NULL REFERENCES users(id),
  title TEXT,
  narrative TEXT NOT NULL,
  raw_transcript TEXT,
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

-- Many-to-many: tales <-> children
CREATE TABLE tale_children (
  tale_id UUID NOT NULL REFERENCES tales(id) ON DELETE CASCADE,
  child_id UUID NOT NULL REFERENCES children(id) ON DELETE CASCADE,
  PRIMARY KEY (tale_id, child_id)
);

-- Tags on tales
CREATE TABLE tale_tags (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  tale_id UUID NOT NULL REFERENCES tales(id) ON DELETE CASCADE,
  tag TEXT NOT NULL,
  UNIQUE (tale_id, tag)
);

-- Media attachments
CREATE TABLE tale_media (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  tale_id UUID NOT NULL REFERENCES tales(id) ON DELETE CASCADE,
  url TEXT NOT NULL,
  media_type TEXT NOT NULL CHECK (media_type IN ('photo', 'video')),
  display_order INT NOT NULL DEFAULT 0,
  created_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

-- Emoji reactions
CREATE TABLE reactions (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  tale_id UUID NOT NULL REFERENCES tales(id) ON DELETE CASCADE,
  user_id UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE,
  emoji TEXT NOT NULL,
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  UNIQUE (tale_id, user_id, emoji)
);

-- Comments
CREATE TABLE comments (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  tale_id UUID NOT NULL REFERENCES tales(id) ON DELETE CASCADE,
  user_id UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE,
  content TEXT NOT NULL,
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

-- Guest invites
CREATE TABLE guest_invites (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  family_account_id UUID NOT NULL REFERENCES family_accounts(id) ON DELETE CASCADE,
  invited_by UUID NOT NULL REFERENCES users(id),
  token TEXT NOT NULL UNIQUE DEFAULT encode(gen_random_bytes(32), 'hex'),
  email TEXT,
  status TEXT NOT NULL DEFAULT 'pending' CHECK (status IN ('pending', 'accepted', 'revoked')),
  created_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

-- Subscriptions
CREATE TABLE subscriptions (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  family_account_id UUID NOT NULL REFERENCES family_accounts(id) ON DELETE CASCADE,
  status TEXT NOT NULL CHECK (status IN ('active', 'cancelled', 'expired')),
  platform TEXT CHECK (platform IN ('ios', 'android')),
  expires_at TIMESTAMPTZ,
  created_at TIMESTAMPTZ NOT NULL DEFAULT now()
);
```

### 3.2 Computed Fields & Views

```sql
-- Count tales per family account (used for free tier enforcement)
CREATE OR REPLACE VIEW family_tale_counts AS
SELECT family_account_id, COUNT(*) as tale_count
FROM tales
GROUP BY family_account_id;
```

